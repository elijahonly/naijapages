# Optional Firebase App Check reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=

# Set to true to disable Content-Security-Policy generation during production build
VITE_DISABLE_CSP=

# Set to true in AI Studio to disable HMR and file watching
DISABLE_HMR=

# Firebase API key (client config is loaded from firebase-applet-config.json)
FIREBASE_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare Frontend Variables (used in Phases 3-5 once API/Auth cutover begins)
# -----------------------------------------------------------------------------
# Base URL for the Cloudflare Worker API in local split-origin dev (leave empty when same-origin)
VITE_API_BASE_URL=

# Cloudflare Turnstile public site key for forms & auth widgets
VITE_TURNSTILE_SITE_KEY=

# Optional public R2 media base URL (e.g., https://media.naijapages.ng)
VITE_R2_PUBLIC_BASE_URL=

